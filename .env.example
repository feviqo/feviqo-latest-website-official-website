# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP Email Configuration for form submissions & notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FEVIQO Studio <partner@feviqo.com>"
NOTIFICATION_EMAIL="partner@feviqo.com"

# Resend Transactional Email API (Alternative to SMTP)
RESEND_API_KEY=

# Production Persistent Storage Configuration
# Default is 'local' (writes to persistent volume /uploads)
# To use S3-compatible cloud storage (AWS S3, Cloudflare R2, Supabase Storage, Google Cloud Storage), set:
STORAGE_PROVIDER="local"
S3_BUCKET=
S3_REGION="auto"
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Max upload limit in megabytes (default 2048 MB = 2 GB)
MAX_UPLOAD_SIZE_MB="2048"

# Admin & API Security
ADMIN_SECRET_KEY=
MEMBER_SESSION_SECRET=

# FEVIQO Membership Payment Gateway Credentials (Required for live payment activation)
# Option 1: Stripe Checkout (PKR)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Option 2: Safepay Pakistan
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=

# Option 3: PayFast Pakistan
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=

# FEVIQO Membership Bank QR, WhatsApp & Admin Panel Configuration
# Admin login & verification notification email (defaults to rexanmedia01@gmail.com if unset)
FEVIQO_ADMIN_EMAIL="rexanmedia01@gmail.com"
FEVIQO_ADMIN_PASSWORD=
# Pakistani / International WhatsApp number in digits with country code (e.g. 923001234567)
FEVIQO_WHATSAPP_NUMBER=
