# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP Email Configuration for form submissions & notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FEVIQO Studio <partner@feviqo.com>"
NOTIFICATION_EMAIL="partner@feviqo.com"

# Resend Transactional Email API (Alternative to SMTP)
RESEND_API_KEY=
RESEND_FROM="FEVIQO Studio <onboarding@resend.dev>"

# Production Persistent Storage Configuration
# Default is 'local' (writes to persistent volume /uploads)
# To use S3-compatible cloud storage (AWS S3, Cloudflare R2, Supabase Storage, Google Cloud Storage), set:
STORAGE_PROVIDER="local"
S3_BUCKET=
S3_REGION="auto"
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Max upload limit in megabytes (default 2048 MB = 2 GB)
MAX_UPLOAD_SIZE_MB="2048"

# Admin & API Security
ADMIN_SECRET_KEY=
MEMBER_SESSION_SECRET=

# FEVIQO Membership Payment Gateway Credentials (Required for live payment activation)
# Option 1: Stripe Checkout (PKR)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Option 2: Safepay Pakistan
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=

# Option 3: PayFast Pakistan
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=

# FEVIQO Membership Bank QR, WhatsApp & Admin Panel Configuration
# Admin login & verification notification email
FEVIQO_ADMIN_EMAIL="partner@feviqo.com"
FEVIQO_ADMIN_PASSWORD=
# Pakistani / International WhatsApp number in digits with country code (e.g. +923227811264)
FEVIQO_WHATSAPP_NUMBER="+923227811264"

# Optional Firebase Admin Service Account JSON (for automatic server-side Firestore persistence across Render restarts)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Mux Video Security, Signed Playback & DRM Configuration
# RS256 Mux URL Signing Key ID & Private Key (PEM or base64-encoded PEM)
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
# Optional Mux Playback Restriction ID (domain & referer allowlist configured in Mux Dashboard)
MUX_PLAYBACK_RESTRICTION_ID=
# Optional Mux DRM Configuration ID (Widevine / FairPlay / PlayReady)
MUX_DRM_CONFIGURATION_ID=
# Comma-separated allowed playback origins/domains for backend validation
MUX_ALLOWED_DOMAINS="feviqo.com,www.feviqo.com,localhost,127.0.0.1"
# Short-lived Mux playback JWT lifetime in seconds (default 300s)
MUX_JWT_TTL_SECONDS="300"
# Dedicated secret for signing FEVIQO HLS proxy stream URLs & session tokens
MUX_STREAM_PROXY_SECRET=
# Optional isolated Mux Playback IDs for premium episodes (JSON map or per-episode env)
MUX_PREMIUM_PLAYBACK_IDS_JSON=
MUX_PLAYBACK_MEHMED_FETIHLER_SULTANI_EPISODE_91=
MUX_PLAYBACK_GUNESIN_DOGDUGU_YER_EPISODE_8=
# Optional Mux REST API credentials for automated asset/policy audits
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

