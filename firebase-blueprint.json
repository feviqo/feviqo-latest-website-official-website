    },
    "/members/{memberId}": {
      "schema": { "$ref": "#/entities/MemberAccount" },
      "description": "Customer member accounts with strict owner or admin PII isolation."
    },
    "/membershipOrders/{orderId}": {
      "schema": { "$ref": "#/entities/MembershipOrder" },
      "description": "Payment verification queue orders and compressed proof screenshots (PKR Bank QR & USD Binance QR, New & Renewal)."
    },
    "/memberships/{membershipId}": {
      "schema": { "$ref": "#/entities/CustomerMembership" },
      "description": "Approved and admin-assigned customer memberships with UTC expiry and renewal history."
    },
    "/membershipHistory/{historyId}": {
      "schema": { "$ref": "#/entities/MembershipHistoryItem" },
      "description": "Immutable customer membership lifecycle audit events."
    },
    "/membershipConfig/{configId}": {
      "schema": { "$ref": "#/entities/MembershipSettings" },
      "description": "Admin-managed Bank QR, Binance USD QR, USD pricing, referral config, and support configuration."
    },
    "/adminAuditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditItem" },
      "description": "Immutable administrator action audit trail."
    },
    "/emailNotifications/{notifId}": {
      "schema": { "$ref": "#/entities/EmailNotificationItem" },
      "description": "Outbound verification and reminder email delivery logs."
    },
    "/memberNotifications/{notifId}": {
      "schema": { "$ref": "#/entities/MemberNotification" },
      "description": "In-account customer renewal reminder, expiry, referral, and payment notifications."
    },
    "/schedulerRuns/{runId}": {
      "schema": { "$ref": "#/entities/SchedulerRun" },
      "description": "Execution logs for the automated membership expiry & renewal reminder scheduler."
    },
    "/promoCodes/{promoId}": {
      "schema": { "$ref": "#/entities/PromoCode" },
      "description": "Admin-managed promotional discount codes."
    },
    "/referrals/{referralId}": {
      "schema": { "$ref": "#/entities/ReferralRecord" },
      "description": "Customer referral attribution and verified conversion reward records."
    },
    "/referralCredits/{entryId}": {
      "schema": { "$ref": "#/entities/ReferralCreditEntry" },
      "description": "Immutable member referral wallet credit ledger entries."
    }
  }
