{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!assets/|images/|logos/|videos/|uploads/|favicon|robots\\.txt|sitemap\\.xml|llms\\.txt|ai-catalog\\.json|ads\\.txt|feviqo-indexnow-key-2026\\.txt).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/logos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
