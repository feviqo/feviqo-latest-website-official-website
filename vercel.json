{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/membership", "destination": "/membership/index.html" },
    { "source": "/membership/:slug", "destination": "/membership/index.html" },
    { "source": "/dramas", "destination": "/dramas/index.html" },
    { "source": "/teskilat", "destination": "/teskilat/index.html" },
    { "source": "/teskilat/:ep", "destination": "/teskilat/:ep/index.html" },
    { "source": "/mehmed-fetihler-sultani", "destination": "/mehmed-fetihler-sultani/index.html" },
    { "source": "/mehmed-fetihler-sultani/:ep", "destination": "/mehmed-fetihler-sultani/:ep/index.html" },
    { "source": "/gunesin-dogdugu-yer", "destination": "/gunesin-dogdugu-yer/index.html" },
    { "source": "/gunesin-dogdugu-yer/:ep", "destination": "/gunesin-dogdugu-yer/:ep/index.html" },
    { "source": "/pricing", "destination": "/pricing/index.html" },
    { "source": "/unlimited-editing", "destination": "/unlimited-editing/index.html" },
    { "source": "/creators", "destination": "/creators/index.html" },
    { "source": "/agencies", "destination": "/agencies/index.html" },
    { "source": "/business", "destination": "/business/index.html" },
    { "source": "/gallery", "destination": "/gallery/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/booking", "destination": "/booking/index.html" },
    { "source": "/case-studies", "destination": "/case-studies/index.html" },
    { "source": "/testimonials", "destination": "/testimonials/index.html" },
    { "source": "/turkish-drama", "destination": "/turkish-drama/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/account", "destination": "/account/index.html" },
    {
      "source": "/((?!assets/|images/|logos/|videos/|uploads/|favicon|robots\\.txt|sitemap\\.xml|llms\\.txt|ai-catalog\\.json|ads\\.txt|feviqo-indexnow-key-2026\\.txt).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/logos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
