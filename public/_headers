# Cloudflare Pages Cache-Control & Security Headers for FEVIQO
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# HTML documents and pre-rendered route entrypoints must always revalidate
# so visitors never receive stale HTML referencing deleted JS/CSS bundle hashes
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=86400, s-maxage=86400
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate
/sw.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
/membership
  Cache-Control: public, max-age=0, must-revalidate
/membership/*
  Cache-Control: public, max-age=0, must-revalidate
/dramas
  Cache-Control: public, max-age=0, must-revalidate
/teskilat
  Cache-Control: public, max-age=0, must-revalidate
/teskilat/*
  Cache-Control: public, max-age=0, must-revalidate
/mehmed-fetihler-sultani
  Cache-Control: public, max-age=0, must-revalidate
/mehmed-fetihler-sultani/*
  Cache-Control: public, max-age=0, must-revalidate
/gunesin-dogdugu-yer
  Cache-Control: public, max-age=0, must-revalidate
/gunesin-dogdugu-yer/*
  Cache-Control: public, max-age=0, must-revalidate
/account
  Cache-Control: public, max-age=0, must-revalidate
/admin
  Cache-Control: public, max-age=0, must-revalidate
/admin/*
  Cache-Control: public, max-age=0, must-revalidate
/pricing
  Cache-Control: public, max-age=0, must-revalidate
/booking
  Cache-Control: public, max-age=0, must-revalidate
/gallery
  Cache-Control: public, max-age=0, must-revalidate
/creators
  Cache-Control: public, max-age=0, must-revalidate
/business
  Cache-Control: public, max-age=0, must-revalidate
/agencies
  Cache-Control: public, max-age=0, must-revalidate
/unlimited-editing
  Cache-Control: public, max-age=0, must-revalidate
/platform
  Cache-Control: public, max-age=0, must-revalidate
/about
  Cache-Control: public, max-age=0, must-revalidate
/privacy
  Cache-Control: public, max-age=0, must-revalidate
/privacy-policy
  Cache-Control: public, max-age=0, must-revalidate
/terms
  Cache-Control: public, max-age=0, must-revalidate
/dmca
  Cache-Control: public, max-age=0, must-revalidate
/contact
  Cache-Control: public, max-age=0, must-revalidate

# Hashed Vite JS/CSS bundles and static fonts/images are immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/images/*
  Cache-Control: public, max-age=31536000, immutable
/logos/*
  Cache-Control: public, max-age=31536000, immutable

# Official Meta WhatsApp Cloud API Webhook endpoint must never be cached
/api/webhooks/whatsapp
  Cache-Control: no-store, no-cache, must-revalidate
  X-Content-Type-Options: nosniff

