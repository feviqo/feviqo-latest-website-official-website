rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED PRIMITIVES ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'rexanmedia01@gmail.com' ||
        request.auth.token.email == 'partner@feviqo.com'
      );
    }

    function isAdmin() {
      return isVerifiedUser() && (
        isBootstrappedAdmin() ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isBoundedString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidDramaIdList(listVal) {
      return listVal is list && listVal.size() >= 1 && listVal.size() <= 10 && listVal[0] is string && listVal[0].size() <= 64;
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---
    function isValidAdminProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'role', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'name', 'role', 'isActive', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && isBoundedString(data.email, 5, 200)
        && isBoundedString(data.name, 1, 120)
        && data.role == 'admin'
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMemberAccount(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'email', 'fullName', 'phone', 'createdAtIso', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'email', 'fullName', 'phone', 'passwordHash',
          'referralCode', 'referredByMemberId', 'referredByCode', 'creditBalancePkr', 'creditBalanceUsd',
          'createdAtIso', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerUid)
        && isBoundedString(data.email, 5, 200)
        && isBoundedString(data.fullName, 2, 120)
        && isBoundedString(data.phone, 0, 32)
        && (!('passwordHash' in data) || isBoundedString(data.passwordHash, 0, 300))
        && (!('referralCode' in data) || isBoundedString(data.referralCode, 0, 32))
        && (!('referredByMemberId' in data) || isBoundedString(data.referredByMemberId, 0, 128))
        && (!('referredByCode' in data) || isBoundedString(data.referredByCode, 0, 32))
        && (!('creditBalancePkr' in data) || (data.creditBalancePkr is number && data.creditBalancePkr >= 0 && data.creditBalancePkr <= 1000000))
        && (!('creditBalanceUsd' in data) || (data.creditBalanceUsd is number && data.creditBalanceUsd >= 0 && data.creditBalanceUsd <= 10000))
        && isBoundedString(data.createdAtIso, 10, 64)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMembershipOrder(data) {
      return data.keys().hasAll([
          'id', 'memberId', 'ownerUid', 'customerName', 'customerEmail',
          'planId', 'planName', 'amountPkr', 'durationDays', 'selectedDramaIds',
          'status', 'provider', 'createdAtIso', 'updatedAtIso', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'memberId', 'ownerUid', 'customerName', 'customerEmail', 'customerPhone',
          'orderType', 'targetMembershipId', 'planId', 'planName', 'amountPkr', 'amountUsd',
          'originalAmountPkr', 'originalAmountUsd', 'promoCodeId', 'promoCode', 'promoDiscountPkr', 'promoDiscountUsd',
          'referralId', 'referralCodeUsed', 'referralDiscountPkr', 'referralDiscountUsd',
          'creditsUsedPkr', 'creditsUsedUsd', 'creditsRefundedAt', 'discountTotalPkr', 'discountTotalUsd',
          'expectedAmount', 'currency', 'paymentRegion', 'paymentMethod', 'visitorCountryCode',
          'indicativeLocalDisplay', 'durationDays', 'selectedDramaIds',
          'status', 'provider', 'qrImageUrl', 'proofFileName', 'proofOriginalName',
          'proofMimeType', 'proofDataUrl', 'proofSubmittedAt', 'paymentNote',
          'rejectionReason', 'reviewedByAdminId', 'reviewedByAdminEmail', 'reviewedAt',
          'paidAt', 'paidAtMs', 'createdAtIso', 'updatedAtIso', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.memberId)
        && isValidId(data.ownerUid)
        && isBoundedString(data.customerName, 1, 120)
        && isBoundedString(data.customerEmail, 5, 200)
        && (!('customerPhone' in data) || isBoundedString(data.customerPhone, 0, 32))
        && (!('orderType' in data) || (data.orderType in ['new', 'renewal']))
        && (!('targetMembershipId' in data) || isBoundedString(data.targetMembershipId, 0, 128))
        && (data.planId in ['starter', 'standard', 'plus', 'vip'])
        && isBoundedString(data.planName, 1, 64)
        && data.amountPkr is number && data.amountPkr >= 0 && data.amountPkr <= 1000000
        && (!('amountUsd' in data) || (data.amountUsd is number && data.amountUsd >= 0 && data.amountUsd <= 10000))
        && (!('originalAmountPkr' in data) || (data.originalAmountPkr is number && data.originalAmountPkr >= 0 && data.originalAmountPkr <= 1000000))
        && (!('originalAmountUsd' in data) || (data.originalAmountUsd is number && data.originalAmountUsd >= 0 && data.originalAmountUsd <= 10000))
        && (!('promoCodeId' in data) || isBoundedString(data.promoCodeId, 0, 128))
        && (!('promoCode' in data) || isBoundedString(data.promoCode, 0, 40))
        && (!('promoDiscountPkr' in data) || (data.promoDiscountPkr is number && data.promoDiscountPkr >= 0 && data.promoDiscountPkr <= 1000000))
        && (!('promoDiscountUsd' in data) || (data.promoDiscountUsd is number && data.promoDiscountUsd >= 0 && data.promoDiscountUsd <= 10000))
        && (!('referralId' in data) || isBoundedString(data.referralId, 0, 128))
        && (!('referralCodeUsed' in data) || isBoundedString(data.referralCodeUsed, 0, 32))
        && (!('referralDiscountPkr' in data) || (data.referralDiscountPkr is number && data.referralDiscountPkr >= 0 && data.referralDiscountPkr <= 1000000))
        && (!('referralDiscountUsd' in data) || (data.referralDiscountUsd is number && data.referralDiscountUsd >= 0 && data.referralDiscountUsd <= 10000))
        && (!('creditsUsedPkr' in data) || (data.creditsUsedPkr is number && data.creditsUsedPkr >= 0 && data.creditsUsedPkr <= 1000000))
        && (!('creditsUsedUsd' in data) || (data.creditsUsedUsd is number && data.creditsUsedUsd >= 0 && data.creditsUsedUsd <= 10000))
        && (!('creditsRefundedAt' in data) || isBoundedString(data.creditsRefundedAt, 0, 64))
        && (!('discountTotalPkr' in data) || (data.discountTotalPkr is number && data.discountTotalPkr >= 0 && data.discountTotalPkr <= 1000000))
        && (!('discountTotalUsd' in data) || (data.discountTotalUsd is number && data.discountTotalUsd >= 0 && data.discountTotalUsd <= 10000))
        && (!('expectedAmount' in data) || (data.expectedAmount is number && data.expectedAmount >= 0 && data.expectedAmount <= 1000000))
        && (!('currency' in data) || (data.currency in ['PKR', 'USD']))
        && (!('paymentRegion' in data) || (data.paymentRegion in ['pakistan', 'international']))
        && (!('paymentMethod' in data) || (data.paymentMethod in ['bank_qr', 'binance_qr', 'admin_assigned']))
        && (!('visitorCountryCode' in data) || isBoundedString(data.visitorCountryCode, 0, 12))
        && (!('indicativeLocalDisplay' in data) || isBoundedString(data.indicativeLocalDisplay, 0, 64))
        && data.durationDays is number && data.durationDays >= 1 && data.durationDays <= 3650
        && isValidDramaIdList(data.selectedDramaIds)
        && (data.status in ['awaiting_payment', 'pending_verification', 'approved', 'rejected', 'expired'])
        && isBoundedString(data.provider, 1, 40)
        && (!('qrImageUrl' in data) || isBoundedString(data.qrImageUrl, 0, 512))
        && (!('proofFileName' in data) || isBoundedString(data.proofFileName, 0, 256))
        && (!('proofOriginalName' in data) || isBoundedString(data.proofOriginalName, 0, 256))
        && (!('proofMimeType' in data) || isBoundedString(data.proofMimeType, 0, 64))
        && (!('proofDataUrl' in data) || isBoundedString(data.proofDataUrl, 0, 800000))
        && (!('proofSubmittedAt' in data) || isBoundedString(data.proofSubmittedAt, 0, 64))
        && (!('paymentNote' in data) || isBoundedString(data.paymentNote, 0, 500))
        && (!('rejectionReason' in data) || isBoundedString(data.rejectionReason, 0, 500))
        && (!('reviewedByAdminId' in data) || isBoundedString(data.reviewedByAdminId, 0, 128))
        && (!('reviewedByAdminEmail' in data) || isBoundedString(data.reviewedByAdminEmail, 0, 200))
        && (!('reviewedAt' in data) || isBoundedString(data.reviewedAt, 0, 64))
        && (!('paidAt' in data) || isBoundedString(data.paidAt, 0, 64))
        && (!('paidAtMs' in data) || data.paidAtMs is number)
        && isBoundedString(data.createdAtIso, 10, 64)
        && isBoundedString(data.updatedAtIso, 10, 64)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomerMembership(data) {
      return data.keys().hasAll([
          'id', 'memberId', 'ownerUid', 'orderId', 'customerName', 'customerEmail',
          'planId', 'planName', 'pricePkr', 'durationDays', 'selectedDramaIds',
          'status', 'activatedAt', 'expiresAt', 'paymentProvider',
          'createdAtIso', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'memberId', 'ownerUid', 'orderId', 'customerName', 'customerEmail', 'customerPhone',
          'planId', 'planName', 'pricePkr', 'priceUsd',
          'originalAmountPkr', 'originalAmountUsd', 'promoCode', 'promoDiscountPkr', 'promoDiscountUsd',
          'referralDiscountPkr', 'referralDiscountUsd', 'creditsUsedPkr', 'creditsUsedUsd',
          'discountTotalPkr', 'discountTotalUsd', 'durationDays', 'selectedDramaIds',
          'status', 'activatedAt', 'expiresAt', 'cancelledAt', 'revokedByAdminEmail',
          'revokedReason', 'approvedByAdminEmail', 'paymentProvider', 'paymentRegion',
          'paymentMethod', 'currency', 'expectedAmount', 'paymentReference',
          'renewalHistory', 'lastExtendedAt', 'createdAtIso', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.memberId)
        && isValidId(data.ownerUid)
        && isValidId(data.orderId)
        && isBoundedString(data.customerName, 1, 120)
        && isBoundedString(data.customerEmail, 5, 200)
        && (!('customerPhone' in data) || isBoundedString(data.customerPhone, 0, 32))
        && (data.planId in ['starter', 'standard', 'plus', 'vip'])
        && isBoundedString(data.planName, 1, 64)
        && data.pricePkr is number && data.pricePkr >= 0 && data.pricePkr <= 1000000
        && (!('priceUsd' in data) || (data.priceUsd is number && data.priceUsd >= 0 && data.priceUsd <= 10000))
        && (!('originalAmountPkr' in data) || (data.originalAmountPkr is number && data.originalAmountPkr >= 0 && data.originalAmountPkr <= 1000000))
        && (!('originalAmountUsd' in data) || (data.originalAmountUsd is number && data.originalAmountUsd >= 0 && data.originalAmountUsd <= 10000))
        && (!('promoCode' in data) || isBoundedString(data.promoCode, 0, 40))
        && (!('promoDiscountPkr' in data) || (data.promoDiscountPkr is number && data.promoDiscountPkr >= 0 && data.promoDiscountPkr <= 1000000))
        && (!('promoDiscountUsd' in data) || (data.promoDiscountUsd is number && data.promoDiscountUsd >= 0 && data.promoDiscountUsd <= 10000))
        && (!('referralDiscountPkr' in data) || (data.referralDiscountPkr is number && data.referralDiscountPkr >= 0 && data.referralDiscountPkr <= 1000000))
        && (!('referralDiscountUsd' in data) || (data.referralDiscountUsd is number && data.referralDiscountUsd >= 0 && data.referralDiscountUsd <= 10000))
        && (!('creditsUsedPkr' in data) || (data.creditsUsedPkr is number && data.creditsUsedPkr >= 0 && data.creditsUsedPkr <= 1000000))
        && (!('creditsUsedUsd' in data) || (data.creditsUsedUsd is number && data.creditsUsedUsd >= 0 && data.creditsUsedUsd <= 10000))
        && (!('discountTotalPkr' in data) || (data.discountTotalPkr is number && data.discountTotalPkr >= 0 && data.discountTotalPkr <= 1000000))
        && (!('discountTotalUsd' in data) || (data.discountTotalUsd is number && data.discountTotalUsd >= 0 && data.discountTotalUsd <= 10000))
        && data.durationDays is number && data.durationDays >= 1 && data.durationDays <= 3650
        && isValidDramaIdList(data.selectedDramaIds)
        && (data.status in ['active', 'cancelled', 'expired'])
        && isBoundedString(data.activatedAt, 10, 64)
        && isBoundedString(data.expiresAt, 10, 64)
        && (!('cancelledAt' in data) || isBoundedString(data.cancelledAt, 0, 64))
        && (!('revokedByAdminEmail' in data) || isBoundedString(data.revokedByAdminEmail, 0, 200))
        && (!('revokedReason' in data) || isBoundedString(data.revokedReason, 0, 500))
        && (!('approvedByAdminEmail' in data) || isBoundedString(data.approvedByAdminEmail, 0, 200))
        && isBoundedString(data.paymentProvider, 1, 40)
        && (!('paymentRegion' in data) || (data.paymentRegion in ['pakistan', 'international']))
        && (!('paymentMethod' in data) || (data.paymentMethod in ['bank_qr', 'binance_qr', 'admin_assigned']))
        && (!('currency' in data) || (data.currency in ['PKR', 'USD']))
        && (!('expectedAmount' in data) || (data.expectedAmount is number && data.expectedAmount >= 0 && data.expectedAmount <= 1000000))
        && (!('paymentReference' in data) || isBoundedString(data.paymentReference, 0, 400))
        && (!('renewalHistory' in data) || (data.renewalHistory is list && data.renewalHistory.size() <= 100))
        && (!('lastExtendedAt' in data) || isBoundedString(data.lastExtendedAt, 0, 64))
        && isBoundedString(data.createdAtIso, 10, 64)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMembershipHistoryItem(data) {
      return data.keys().hasAll(['id', 'memberId', 'ownerUid', 'event', 'details', 'createdAtIso', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'memberId', 'ownerUid', 'membershipId', 'orderId', 'event',
          'planId', 'planName', 'amountPkr', 'amountUsd', 'currency', 'selectedDramaIds', 'details',
          'createdAtIso', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.memberId)
        && isValidId(data.ownerUid)
        && (!('membershipId' in data) || isBoundedString(data.membershipId, 0, 128))
        && (!('orderId' in data) || isBoundedString(data.orderId, 0, 128))
        && isBoundedString(data.event, 1, 64)
        && (!('planId' in data) || isBoundedString(data.planId, 0, 32))
        && (!('planName' in data) || isBoundedString(data.planName, 0, 64))
        && (!('amountPkr' in data) || (data.amountPkr is number && data.amountPkr >= 0 && data.amountPkr <= 1000000))
        && (!('amountUsd' in data) || (data.amountUsd is number && data.amountUsd >= 0 && data.amountUsd <= 10000))
        && (!('currency' in data) || (data.currency in ['PKR', 'USD']))
        && (!('selectedDramaIds' in data) || isValidDramaIdList(data.selectedDramaIds))
        && isBoundedString(data.details, 1, 1000)
        && isBoundedString(data.createdAtIso, 10, 64)
        && data.createdAt is timestamp;
    }

    function isValidMembershipSettings(data) {
      return data.keys().hasAll([
          'starterQrImage', 'standardQrImage', 'plusQrImage', 'vipQrImage',
          'adminEmail', 'supportEmail', 'updatedAtIso', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'starterQrImage', 'standardQrImage', 'plusQrImage', 'vipQrImage',
          'starterBinanceQrImage', 'standardBinanceQrImage', 'plusBinanceQrImage', 'vipBinanceQrImage',
          'usdPrices', 'internationalInstructionsEn', 'internationalInstructionsUr',
          'whatsappNumber', 'adminEmail', 'supportEmail', 'supportNoteEn',
          'supportNoteUr', 'referralConfig', 'updatedAtIso', 'updatedAt'
        ])
        && isBoundedString(data.starterQrImage, 1, 512)
        && isBoundedString(data.standardQrImage, 1, 512)
        && isBoundedString(data.plusQrImage, 1, 512)
        && isBoundedString(data.vipQrImage, 1, 512)
        && (!('starterBinanceQrImage' in data) || isBoundedString(data.starterBinanceQrImage, 0, 512))
        && (!('standardBinanceQrImage' in data) || isBoundedString(data.standardBinanceQrImage, 0, 512))
        && (!('plusBinanceQrImage' in data) || isBoundedString(data.plusBinanceQrImage, 0, 512))
        && (!('vipBinanceQrImage' in data) || isBoundedString(data.vipBinanceQrImage, 0, 512))
        && (!('usdPrices' in data) || data.usdPrices is map)
        && (!('internationalInstructionsEn' in data) || isBoundedString(data.internationalInstructionsEn, 0, 1500))
        && (!('internationalInstructionsUr' in data) || isBoundedString(data.internationalInstructionsUr, 0, 1500))
        && (!('whatsappNumber' in data) || isBoundedString(data.whatsappNumber, 0, 40))
        && isBoundedString(data.adminEmail, 5, 200)
        && isBoundedString(data.supportEmail, 5, 200)
        && (!('supportNoteEn' in data) || isBoundedString(data.supportNoteEn, 0, 1000))
        && (!('supportNoteUr' in data) || isBoundedString(data.supportNoteUr, 0, 1000))
        && (!('referralConfig' in data) || data.referralConfig is map)
        && isBoundedString(data.updatedAtIso, 10, 64)
        && data.updatedAt is timestamp;
    }

    function isValidAdminAuditItem(data) {
      return data.keys().hasAll(['id', 'adminId', 'adminEmail', 'action', 'details', 'createdAtIso', 'createdAt'])
        && data.keys().hasOnly(['id', 'adminId', 'adminEmail', 'action', 'targetId', 'details', 'createdAtIso', 'createdAt'])
        && isValidId(data.id)
        && isBoundedString(data.adminId, 1, 128)
        && isBoundedString(data.adminEmail, 5, 200)
        && isBoundedString(data.action, 1, 64)
        && (!('targetId' in data) || isBoundedString(data.targetId, 0, 128))
        && isBoundedString(data.details, 1, 1000)
        && isBoundedString(data.createdAtIso, 10, 64)
        && data.createdAt is timestamp;
    }

    function isValidEmailNotificationItem(data) {
      return data.keys().hasAll(['id', 'to', 'subject', 'type', 'status', 'attempts', 'createdAtIso', 'lastAttemptAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'orderId', 'membershipId', 'customerNotificationId', 'to', 'subject', 'type', 'status', 'provider',
          'error', 'attempts', 'createdAtIso', 'lastAttemptAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && (!('orderId' in data) || isBoundedString(data.orderId, 0, 128))
        && (!('membershipId' in data) || isBoundedString(data.membershipId, 0, 128))
        && (!('customerNotificationId' in data) || isBoundedString(data.customerNotificationId, 0, 128))
        && isBoundedString(data.to, 5, 200)
        && isBoundedString(data.subject, 1, 300)
        && isBoundedString(data.type, 1, 64)
        && (data.status in ['sent', 'failed'])
        && (!('provider' in data) || isBoundedString(data.provider, 0, 64))
        && (!('error' in data) || isBoundedString(data.error, 0, 1000))
        && data.attempts is number && data.attempts >= 1 && data.attempts <= 100
        && isBoundedString(data.createdAtIso, 10, 64)
        && isBoundedString(data.lastAttemptAt, 10, 64)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMemberNotification(data) {
      return data.keys().hasAll([
          'id', 'memberId', 'ownerUid', 'type', 'title', 'message',
          'dedupeKey', 'emailStatus', 'isRead', 'createdAtIso', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'memberId', 'ownerUid', 'customerEmail', 'membershipId', 'orderId', 'planId', 'dramaIds',
          'type', 'title', 'titleUr', 'message', 'messageUr', 'ctaLabel', 'ctaHref',
          'dedupeKey', 'emailStatus', 'emailError', 'isRead', 'readAt', 'supersededAt',
          'createdAtIso', 'updatedAtIso', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.memberId)
        && isValidId(data.ownerUid)
        && (!('customerEmail' in data) || isBoundedString(data.customerEmail, 0, 200))
        && (!('membershipId' in data) || isBoundedString(data.membershipId, 0, 128))
        && (!('orderId' in data) || isBoundedString(data.orderId, 0, 128))
        && (!('planId' in data) || isBoundedString(data.planId, 0, 32))
        && (!('dramaIds' in data) || (data.dramaIds is list && data.dramaIds.size() <= 10))
        && isBoundedString(data.type, 1, 64)
        && isBoundedString(data.title, 1, 240)
        && (!('titleUr' in data) || isBoundedString(data.titleUr, 0, 240))
        && isBoundedString(data.message, 1, 1200)
        && (!('messageUr' in data) || isBoundedString(data.messageUr, 0, 1200))
        && (!('ctaLabel' in data) || isBoundedString(data.ctaLabel, 0, 100))
        && (!('ctaHref' in data) || isBoundedString(data.ctaHref, 0, 240))
        && isBoundedString(data.dedupeKey, 3, 240)
        && (data.emailStatus in ['not_sent', 'not_configured', 'sent', 'failed'])
        && (!('emailError' in data) || isBoundedString(data.emailError, 0, 500))
        && data.isRead is bool
        && (!('readAt' in data) || isBoundedString(data.readAt, 0, 64))
        && (!('supersededAt' in data) || isBoundedString(data.supersededAt, 0, 64))
        && isBoundedString(data.createdAtIso, 10, 64)
        && (!('updatedAtIso' in data) || isBoundedString(data.updatedAtIso, 0, 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSchedulerRun(data) {
      return data.keys().hasAll([
          'id', 'triggerSource', 'ranAt', 'checkedMemberships',
          'expiredCount', 'remindersCreated', 'summary', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'triggerSource', 'ranAt', 'ranAtIso', 'durationMs',
          'checkedMemberships', 'expiredCount', 'remindersCreated',
          'emailsSent', 'emailsFailed', 'emailsNotConfigured',
          'summary', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isBoundedString(data.triggerSource, 1, 64)
        && isBoundedString(data.ranAt, 10, 64)
        && data.checkedMemberships is number
        && data.expiredCount is number
        && data.remindersCreated is number
        && isBoundedString(data.summary, 1, 1000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPromoCode(data) {
      return data.keys().hasAll(['id', 'code', 'discountType', 'isActive', 'createdAtIso', 'updatedAtIso', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'code', 'description', 'discountType', 'discountPercent',
          'discountAmountPkr', 'discountAmountUsd', 'maxDiscountPkr', 'maxDiscountUsd',
          'minPurchasePkr', 'minPurchaseUsd', 'applicablePlanIds', 'usageLimit', 'perUserLimit',
          'expiresAt', 'isActive', 'createdByAdminEmail', 'rewardForReferrerMemberId',
          'createdAtIso', 'updatedAtIso', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isBoundedString(data.code, 2, 40)
        && (!('description' in data) || isBoundedString(data.description, 0, 300))
        && (data.discountType in ['percentage', 'fixed'])
        && (!('discountPercent' in data) || (data.discountPercent is number && data.discountPercent >= 0 && data.discountPercent <= 100))
        && (!('discountAmountPkr' in data) || (data.discountAmountPkr is number && data.discountAmountPkr >= 0 && data.discountAmountPkr <= 1000000))
        && (!('discountAmountUsd' in data) || (data.discountAmountUsd is number && data.discountAmountUsd >= 0 && data.discountAmountUsd <= 10000))
        && (!('maxDiscountPkr' in data) || (data.maxDiscountPkr is number && data.maxDiscountPkr >= 0 && data.maxDiscountPkr <= 1000000))
        && (!('maxDiscountUsd' in data) || (data.maxDiscountUsd is number && data.maxDiscountUsd >= 0 && data.maxDiscountUsd <= 10000))
        && (!('minPurchasePkr' in data) || (data.minPurchasePkr is number && data.minPurchasePkr >= 0 && data.minPurchasePkr <= 1000000))
        && (!('minPurchaseUsd' in data) || (data.minPurchaseUsd is number && data.minPurchaseUsd >= 0 && data.minPurchaseUsd <= 10000))
        && (!('applicablePlanIds' in data) || (data.applicablePlanIds is list && data.applicablePlanIds.size() <= 10))
        && (!('perUserLimit' in data) || (data.perUserLimit is number && data.perUserLimit >= 1 && data.perUserLimit <= 1000))
        && (!('expiresAt' in data) || isBoundedString(data.expiresAt, 0, 64))
        && data.isActive is bool
        && (!('createdByAdminEmail' in data) || isBoundedString(data.createdByAdminEmail, 0, 200))
        && (!('rewardForReferrerMemberId' in data) || isBoundedString(data.rewardForReferrerMemberId, 0, 128))
        && isBoundedString(data.createdAtIso, 10, 64)
        && isBoundedString(data.updatedAtIso, 10, 64)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReferralRecord(data) {
      return data.keys().hasAll([
          'id', 'referrerMemberId', 'referrerCode', 'referredMemberId', 'status',
          'createdAtIso', 'updatedAtIso', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'referrerMemberId', 'referrerCode', 'referrerEmail', 'referrerName',
          'referredMemberId', 'referredOwnerUid', 'referredEmail', 'referredName',
          'referredPhoneNormalized', 'status', 'blockReason', 'conversionOrderId', 'convertedAt',
          'rewardMode', 'rewardAmountPkr', 'rewardAmountUsd', 'rewardPromoCode', 'rewardIssuedAt',
          'createdAtIso', 'updatedAtIso', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.referrerMemberId)
        && isBoundedString(data.referrerCode, 2, 32)
        && (!('referrerEmail' in data) || isBoundedString(data.referrerEmail, 0, 200))
        && (!('referrerName' in data) || isBoundedString(data.referrerName, 0, 120))
        && isValidId(data.referredMemberId)
        && (!('referredOwnerUid' in data) || isBoundedString(data.referredOwnerUid, 0, 128))
        && (!('referredEmail' in data) || isBoundedString(data.referredEmail, 0, 200))
        && (!('referredName' in data) || isBoundedString(data.referredName, 0, 120))
        && (!('referredPhoneNormalized' in data) || isBoundedString(data.referredPhoneNormalized, 0, 32))
        && (data.status in ['signed_up', 'converted', 'blocked'])
        && (!('blockReason' in data) || isBoundedString(data.blockReason, 0, 300))
        && (!('conversionOrderId' in data) || isBoundedString(data.conversionOrderId, 0, 128))
        && (!('convertedAt' in data) || isBoundedString(data.convertedAt, 0, 64))
        && (!('rewardMode' in data) || isBoundedString(data.rewardMode, 0, 32))
        && (!('rewardAmountPkr' in data) || (data.rewardAmountPkr is number && data.rewardAmountPkr >= 0 && data.rewardAmountPkr <= 1000000))
        && (!('rewardAmountUsd' in data) || (data.rewardAmountUsd is number && data.rewardAmountUsd >= 0 && data.rewardAmountUsd <= 10000))
        && (!('rewardPromoCode' in data) || isBoundedString(data.rewardPromoCode, 0, 40))
        && (!('rewardIssuedAt' in data) || isBoundedString(data.rewardIssuedAt, 0, 64))
        && isBoundedString(data.createdAtIso, 10, 64)
        && isBoundedString(data.updatedAtIso, 10, 64)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReferralCreditEntry(data) {
      return data.keys().hasAll(['id', 'memberId', 'type', 'currency', 'details', 'createdAtIso', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'memberId', 'type', 'amountPkr', 'amountUsd', 'currency',
          'referralId', 'orderId', 'details', 'createdAtIso', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.memberId)
        && (data.type in ['referral_bonus', 'checkout_spent', 'checkout_refund', 'admin_adjustment'])
        && (!('amountPkr' in data) || data.amountPkr is number)
        && (!('amountUsd' in data) || data.amountUsd is number)
        && (data.currency in ['PKR', 'USD'])
        && (!('referralId' in data) || isBoundedString(data.referralId, 0, 128))
        && (!('orderId' in data) || isBoundedString(data.orderId, 0, 128))
        && isBoundedString(data.details, 1, 500)
        && isBoundedString(data.createdAtIso, 10, 64)
        && data.createdAt is timestamp;
    }

    // --- COLLECTION MATCH BLOCKS ---
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && isVerifiedUser() && (request.auth.uid == adminUid || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(adminUid) && isAdmin()
        && isValidAdminProfile(incoming())
        && incoming().uid == adminUid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(adminUid) && isAdmin()
        && isValidAdminProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'isActive', 'updatedAt']);
      allow delete: if false;
    }

    match /members/{memberId} {
      allow get: if isValidId(memberId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.ownerUid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(memberId) && isVerifiedUser()
        && isValidMemberAccount(incoming())
        && incoming().id == memberId
        && (incoming().ownerUid == request.auth.uid || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(memberId) && isVerifiedUser()
        && isValidMemberAccount(incoming())
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().createdAtIso == existing().createdAtIso
        && incoming().updatedAt == request.time
        && (
          (existing().ownerUid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phone', 'updatedAt']))
          || (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'fullName', 'phone', 'email', 'passwordHash',
            'referralCode', 'referredByMemberId', 'referredByCode',
            'creditBalancePkr', 'creditBalanceUsd', 'updatedAt'
          ]))
        );
      allow delete: if isValidId(memberId) && isAdmin();
    }

    match /membershipOrders/{orderId} {
      allow get: if isValidId(orderId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.ownerUid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(orderId) && isVerifiedUser()
        && isValidMembershipOrder(incoming())
        && incoming().id == orderId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            incoming().ownerUid == request.auth.uid
            && incoming().status == 'awaiting_payment'
            && exists(/databases/$(database)/documents/members/$(incoming().memberId))
            && get(/databases/$(database)/documents/members/$(incoming().memberId)).data.ownerUid == request.auth.uid
          )
        );
      allow update: if isValidId(orderId) && isVerifiedUser()
        && isValidMembershipOrder(incoming())
        && incoming().id == existing().id
        && incoming().memberId == existing().memberId
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().createdAtIso == existing().createdAtIso
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().ownerUid == request.auth.uid
            && existing().status != 'approved'
            && existing().status != 'expired'
            && incoming().status == 'pending_verification'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'proofFileName', 'proofOriginalName', 'proofMimeType',
              'proofDataUrl', 'proofSubmittedAt', 'paymentNote', 'rejectionReason',
              'updatedAtIso', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(orderId) && isAdmin();
    }

    match /memberships/{membershipId} {
      allow get: if isValidId(membershipId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.ownerUid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(membershipId) && isAdmin()
        && isValidCustomerMembership(incoming())
        && incoming().id == membershipId
        && exists(/databases/$(database)/documents/members/$(incoming().memberId))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(membershipId) && isVerifiedUser()
        && isValidCustomerMembership(incoming())
        && incoming().id == existing().id
        && incoming().memberId == existing().memberId
        && incoming().ownerUid == existing().ownerUid
        && incoming().orderId == existing().orderId
        && incoming().createdAt == existing().createdAt
        && incoming().createdAtIso == existing().createdAtIso
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().ownerUid == request.auth.uid
            && existing().status == 'active'
            && incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancelledAt', 'updatedAt'])
          )
        );
      allow delete: if isValidId(membershipId) && isAdmin();
    }

    match /membershipHistory/{historyId} {
      allow get: if isValidId(historyId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.ownerUid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(historyId) && isVerifiedUser()
        && isValidMembershipHistoryItem(incoming())
        && incoming().id == historyId
        && (incoming().ownerUid == request.auth.uid || isAdmin())
        && exists(/databases/$(database)/documents/members/$(incoming().memberId))
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(historyId) && isAdmin();
    }

    match /membershipConfig/{configId} {
      allow get: if isValidId(configId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(configId) && isAdmin()
        && isValidMembershipSettings(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(configId) && isAdmin()
        && isValidMembershipSettings(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'starterQrImage', 'standardQrImage', 'plusQrImage', 'vipQrImage',
          'starterBinanceQrImage', 'standardBinanceQrImage', 'plusBinanceQrImage', 'vipBinanceQrImage',
          'usdPrices', 'internationalInstructionsEn', 'internationalInstructionsUr',
          'whatsappNumber', 'adminEmail', 'supportEmail', 'supportNoteEn',
          'supportNoteUr', 'referralConfig', 'updatedAtIso', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /adminAuditLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(logId) && isAdmin()
        && isValidAdminAuditItem(incoming())
        && incoming().id == logId
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /emailNotifications/{notifId} {
      allow get: if isValidId(notifId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(notifId) && isAdmin()
        && isValidEmailNotificationItem(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(notifId) && isAdmin()
        && isValidEmailNotificationItem(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'provider', 'error', 'attempts', 'lastAttemptAt', 'updatedAt']);
      allow delete: if false;
    }

    match /memberNotifications/{notifId} {
      allow get: if isValidId(notifId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.ownerUid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(notifId) && isAdmin()
        && isValidMemberNotification(incoming())
        && incoming().id == notifId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(notifId) && isVerifiedUser()
        && isValidMemberNotification(incoming())
        && incoming().id == existing().id
        && incoming().memberId == existing().memberId
        && incoming().ownerUid == existing().ownerUid
        && incoming().dedupeKey == existing().dedupeKey
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().ownerUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'readAt', 'updatedAt'])
          )
        );
      allow delete: if isValidId(notifId) && isAdmin();
    }

    match /schedulerRuns/{runId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(runId) && isAdmin()
        && isValidSchedulerRun(incoming())
        && incoming().id == runId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update, delete: if false;
    }

    match /promoCodes/{promoId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(promoId) && isAdmin()
        && isValidPromoCode(incoming())
        && incoming().id == promoId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(promoId) && isAdmin()
        && isValidPromoCode(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().createdAtIso == existing().createdAtIso
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(promoId) && isAdmin();
    }

    match /referrals/{referralId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(referralId) && isAdmin()
        && isValidReferralRecord(incoming())
        && incoming().id == referralId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(referralId) && isAdmin()
        && isValidReferralRecord(incoming())
        && incoming().id == existing().id
        && incoming().referrerMemberId == existing().referrerMemberId
        && incoming().referredMemberId == existing().referredMemberId
        && incoming().createdAt == existing().createdAt
        && incoming().createdAtIso == existing().createdAtIso
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(referralId) && isAdmin();
    }

    match /referralCredits/{entryId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(entryId) && isAdmin()
        && isValidReferralCreditEntry(incoming())
        && incoming().id == entryId
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
